# Folder yang berisi chunks.jsonl, embeddings_bge_m3.npy, bm25_index.pkl
DSNMUI_PROJECT_DIR=dsnmui_rag_precompute_arabic_fix
PRECOMP_DIR=dsnmui_rag_precompute_arabic_fix/precomputed

# Retrieval
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_MAX_LENGTH=8192
USE_FP16=1
VECTOR_TOP_K=60
BM25_TOP_K=60
HYBRID_TOP_K=36
FINAL_CONTEXT_K=4
DEBUG_RETRIEVAL_STEPS=0

# Prompt/generation text-only via Qwen3-VL adapter
MAX_NEW_TOKENS=520
MAX_PROMPT_TOKENS=6144
MAX_CONTEXT_CHARS_PER_SOURCE=2200
MAX_CONTEXT_TOTAL_CHARS=3600
MAX_DALIL_CHARS_PER_SOURCE=1200

# Visual Dalil / Reasoning Qwen3-VL
VISUAL_DALIL_ENABLED=0
VISUAL_DALIL_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
VISUAL_DALIL_MAX_SOURCES=2
VISUAL_DALIL_MAX_CROPS_PER_SOURCE=4
VISUAL_DALIL_RENDER_DPI=300
VISUAL_DALIL_MAX_NEW_TOKENS=420

# FastAPI/ngrok
# Preview FE/API tanpa memuat artifact, BGE-M3, atau Qwen3-VL.
# Ubah ke 1 hanya ketika artifact siap dan ingin menjalankan inference.
RAG_LOAD_PIPELINE=0
RAG_API_KEY=ubah-ini-untuk-demo
PRELOAD_BGE=0
PRELOAD_VL=0
CORS_ORIGINS=*
API_PORT=8300
